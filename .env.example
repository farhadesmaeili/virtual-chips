# Copy to .env and fill in the values:  cp .env.example .env

# --- Required now ---

# Database (Prisma). Used by `datasource db` in prisma/schema.prisma.
# Host port 5433 maps to the Docker postgres (see docker-compose.yml); 5433
# avoids clashing with a natively installed PostgreSQL on the default 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/virtual_chips?schema=public"

# --- Used from later phases (safe to leave as-is for now) ---

# Auth.js / NextAuth (Phase 2). Generate the secret with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Redis — Socket.io adapter for horizontal scale (Phase 3/7, optional in dev)
REDIS_URL="redis://localhost:6379"

# Custom server (Phase 3). Until then the app runs via `next dev`.
PORT=3000
NODE_ENV=development
