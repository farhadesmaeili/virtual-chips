# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/virtual_chips?schema=public"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Redis (برای Socket.io adapter — اختیاری در dev)
