// Prisma schema — Virtual Chips
// Persistence model behind the application ports. Per-hand betting state lives
// in Hand.state (JSON snapshot of the domain Hand); RoomMember holds the
// durable chip balances. Enum casing differs from the domain string unions and
// is mapped at the repository layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  username    String       @unique
  password    String // hash — never plain text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships RoomMember[]
  settlements Settlement[]
  bankedRooms Room[]       @relation("RoomBanker")
}

model Room {
  id       String     @id @default(cuid())
  name     String
  bankerId String
  status   RoomStatus @default(WAITING)

  // Game settings (mirror the domain RoomSettings value object).
  actionTimeoutMs Int            @default(30000)
  smallBlind      Int            @default(1)
  bigBlind        Int            @default(2)
  minBuyIn        Int            @default(20) // 10 * default BB(2); real derivation in app layer
  maxBuyIn        Int? // null = no maximum
  settlementMode  SettlementMode @default(BANKER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banker  User         @relation("RoomBanker", fields: [bankerId], references: [id])
  members RoomMember[]
  games   Game[]

  @@index([bankerId])
}

model RoomMember {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  seat       Int
  buyInTotal Int      @default(0)
  chips      Int      @default(0)
  // Sit-out keeps the seat and chips but skips new hands until the player sits
  // back in (task 4.14). Persisted so it carries across hands.
  sittingOut Boolean  @default(false)
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
  @@unique([roomId, seat])
  @@index([userId])
}

model Game {
  id        String    @id @default(cuid())
  roomId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  updatedAt DateTime  @updatedAt

  room        Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hands       Hand[]
  settlements Settlement[]

  @@index([roomId])
}

model Hand {
  id        String   @id @default(cuid())
  gameId    String
  // Snapshot of the domain Hand state (for live state and history).
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game    Game        @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actions ActionLog[]

  @@index([gameId])
}

model ActionLog {
  id        String     @id @default(cuid())
  handId    String
  seat      Int
  action    ActionType
  amount    Int?
  createdAt DateTime   @default(now())

  hand Hand @relation(fields: [handId], references: [id], onDelete: Cascade)

  @@index([handId])
}

model Settlement {
  id        String   @id @default(cuid())
  gameId    String
  userId    String
  net       Int // positive = win, negative = loss
  createdAt DateTime @default(now())

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([gameId])
  @@index([userId])
}

enum RoomStatus {
  WAITING
  PLAYING
  ENDED
}

enum SettlementMode {
  BANKER
  SHOWDOWN
}

enum ActionType {
  FOLD
  CHECK
  CALL
  BET
  RAISE
  ALL_IN
}
